<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Имя"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/etName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Введите имя"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@id/tvName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Группа"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/etName"
        app:layout_constraintStart_toStartOf="parent"/>

    <RadioGroup
        android:id="@+id/rgGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvGroup"
        app:layout_constraintStart_toStartOf="parent">

        <RadioButton
            android:id="@+id/rbGroup1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ИС-31" />
        <RadioButton
            android:id="@+id/rbGroup2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ИС-32" />
        <RadioButton
            android:id="@+id/rbGroup3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ИС-33" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvAge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Возраст"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/rgGroup"
        app:layout_constraintStart_toStartOf="parent"/>

    <SeekBar
        android:id="@+id/sbAge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="50"
        android:progress="18"
        app:layout_constraintTop_toBottomOf="@id/tvAge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvAgeValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="18"
        app:layout_constraintTop_toBottomOf="@id/sbAge"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvBirthDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Дата рождения"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvAgeValue"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/etBirthDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="ДД.ММ.ГГГГ"
        android:inputType="date"
        app:layout_constraintTop_toBottomOf="@id/tvBirthDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

