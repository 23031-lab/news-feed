package com.example.a23;

import android.content.Intent;
import android.os.Bundle;
import android.view.View;
import android.widget.Button;

import androidx.activity.EdgeToEdge;
import androidx.appcompat.app.AppCompatActivity;
import androidx.cardview.widget.CardView;
import androidx.core.graphics.Insets;
import androidx.core.view.ViewCompat;
import androidx.core.view.WindowInsetsCompat;

public class MainActivity extends AppCompatActivity {

    private CardView cardWork, cardPersonal, cardShopping, cardStudy;
    private Button btnWork, btnPersonal, btnShopping, btnStudy;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        cardWork = findViewById(R.id.cardWork);
        cardPersonal = findViewById(R.id.cardPersonal);
        cardShopping = findViewById(R.id.cardShopping);
        cardStudy = findViewById(R.id.cardStudy);

        btnWork = findViewById(R.id.btnWork);
        btnPersonal = findViewById(R.id.btnPersonal);
        btnShopping = findViewById(R.id.btnShopping);
        btnStudy = findViewById(R.id.btnStudy);

        setupClickListeners();
    }

    private void setupClickListeners() {
        View.OnClickListener listener = new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Intent intent = new Intent(MainActivity.this, MainActivity2.class);
                String category = "";

                if (v.getId() == R.id.cardWork || v.getId() == R.id.btnWork) {
                    category = "Работа";
                } else if (v.getId() == R.id.cardPersonal || v.getId() == R.id.btnPersonal) {
                    category = "Личное";
                } else if (v.getId() == R.id.cardShopping || v.getId() == R.id.btnShopping) {
                    category = "Покупки";
                } else if (v.getId() == R.id.cardStudy || v.getId() == R.id.btnStudy) {
                    category = "Учёба";
                }

                intent.putExtra("category", category);
                startActivity(intent);
            }
        };

        cardWork.setOnClickListener(listener);
        cardPersonal.setOnClickListener(listener);
        cardShopping.setOnClickListener(listener);
        cardStudy.setOnClickListener(listener);

        btnWork.setOnClickListener(listener);
        btnPersonal.setOnClickListener(listener);
        btnShopping.setOnClickListener(listener);
        btnStudy.setOnClickListener(listener);
    }
}


